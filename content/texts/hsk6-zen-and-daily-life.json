  "grammar": [
    {
      "p": "既没有…，也没有…",
      "e": "'Neither A nor B' — the negative use of the 既…也… pair, listing two things that equally failed to happen. 例：那次会议既没有解决问题，也没有安排下一步。",
      "x": "他们既没有真正吃饭，也没有真正睡觉。 — They neither truly ate nor truly slept."
    },
    {
      "p": "连…都…",
      "e": "'Even…' — 连 fronts the most extreme or most basic item, and 都 (or 也) marks it as included, implying everything lesser follows. 例：他连自己的生日都忘了。",
      "x": "事后连自己吃了什么都想不起来。 — Afterwards you cannot even recall what you ate."
    },
    {
      "p": "把 A 当成 B",
      "e": "'To treat A as B' — 把 fronts the object, 当成 (also 当作) states the identity assigned to it, often a mistaken one. 例：别把客气话当成承诺。",
      "x": "把专注当成又一项必须完成的任务，本身就违背了禅的本意。 — Treating concentration as yet another task to be completed already goes against the point of Zen."
    }
  ]
