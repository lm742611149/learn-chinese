  "grammar": [
    {
      "p": "别…了 — stop doing that",
      "e": "别 + verb + 了 asks somebody to STOP something they are already doing: 别玩手机了, 别说了. Without 了 it is a plain 'don't do it'.",
      "x": "别玩手机了，快吃吧。 — Put the phone down and eat."
    },
    {
      "p": "在 + verb — happening right now",
      "e": "Put 在 before the verb for an action in progress: 他在看手机, 朋友在等我. 正在 means the same and is a little stronger.",
      "x": "我的朋友在等我。 — My friend is waiting for me."
    },
    {
      "p": "…以后，就… — after …, right away",
      "e": "以后 follows the first action (听了以后 = after hearing), and 就 before the second verb shows it happened immediately.",
      "x": "他听了以后，就不看手机了。 — After hearing that, he stopped looking at his phone."
    }
  ]
