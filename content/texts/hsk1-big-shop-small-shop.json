  "grammar": [
    {
      "p": "的 — possessive/attributive particle",
      "e": "的 links a noun to what comes after it, like 's in English.",
      "x": "大商店的东西很多。 — The big store's things are a lot (the big store has a lot of things)."
    },
    {
      "p": "很 + adjective — adjective predicate",
      "e": "很 plus an adjective forms the predicate; no separate word for \"is\" is needed.",
      "x": "那个商店很小。 — That store is small."
    },
    {
      "p": "也 — also",
      "e": "也 goes right before the verb or adjective to agree with a previous statement.",
