  "grammar": [
    {
      "p": "把 + object + 写在… — the 把 construction",
      "e": "把 moves the object before the verb to show what is done to it and where it ends up: 她把每一步都写在了本子上。",
      "x": "请把这些照片放在桌子上。 — Please put these photos on the table."
    },
    {
      "p": "反而 — on the contrary; instead",
      "e": "反而 marks a result opposite to what one expects: 我讲慢了，她反而学得更快。",
      "x": "吃了药，他反而更难受了。 — After taking the medicine, he felt even worse instead."
    },
    {
      "p": "V不住 / V不上 — potential complements of failure",
      "e": "Inserting 不 between verb and complement says the action cannot succeed: 记不住 (cannot memorize), 跟不上 (cannot keep up).",
      "x": "老师说得太快，我跟不上。 — The teacher speaks too fast; I cannot keep up."
    }
  ]
