  "grammar": [
    {
      "p": "快…了 — about to happen",
      "e": "快 + verb or adjective + 了 says something is on the point of happening: 鱼快好了 (the fish is nearly done), 我快到了 (I'm almost there).",
      "x": "饭快好了。 — Dinner is almost ready."
    },
    {
      "p": "A 比 B + adjective — comparison",
      "e": "比 puts two things side by side: A 比 B 好吃 = A is tastier than B. Do not add 很 before the adjective.",
      "x": "今天的菜比饭馆的好吃。 — Today's food is tastier than the restaurant's."
    },
    {
      "p": "…的时候 — when; while",
      "e": "Put the whole action in front of 的时候: 我做菜的时候 = while I was cooking. The main clause tells you whether it is past or present.",
      "x": "我们吃饭的时候，她说了很多话。 — While we were eating, she talked a lot."
    }
