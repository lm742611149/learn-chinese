  "grammar": [
    {
      "p": "为什么 — asking why",
      "e": "为什么 sits where the answer would sit, right before the verb: 你为什么学中文? There is no word-order change like in English.",
      "x": "你为什么不去？ — Why aren't you going?"
    },
    {
      "p": "已经…了 — already",
      "e": "已经 goes before the verb and 了 closes the sentence. With a length of time it means the action started before and is still going on.",
      "x": "我已经学了两年了。 — I've been studying for two years now."
    },
    {
      "p": "…以前 — before; ago",
      "e": "以前 comes AFTER the time word or the action, the opposite of English: 三年以前 (three years ago), 吃饭以前 (before eating).",
      "x": "睡觉以前我看书。 — I read before going to sleep."
    }
  ]
