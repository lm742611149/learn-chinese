  "grammar": [
    {
      "p": "很 + adjective — adjective predicate",
      "e": "To describe something in Chinese you often just use 很 plus an adjective, with no separate word for \"is\".",
      "x": "小狗很大，小猫很小。 — The dog is big, the cat is small."
    },
    {
      "p": "也 — also",
      "e": "也 goes right before the verb to add another true statement about the same subject.",
      "x": "我家有一个小狗，也有一个小猫。 — My family has a dog, and also has a cat."
    },
    {
      "p": "都 — both / all",
      "e": "都 comes after the two things it describes and before 很 or the verb.",
      "x": "小狗和小猫都很漂亮。 — Both the dog and the cat are pretty."
    }
  ]
